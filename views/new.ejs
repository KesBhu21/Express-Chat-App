<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Write New Chat</title>
  <style>
    /* Reset default margin & padding */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: "Poppins", sans-serif;
    }

    body {
      background: linear-gradient(135deg, #dbeafe, #f5f3ff);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .container {
      background: #fff;
      padding: 2rem 3rem;
      border-radius: 1rem;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
      width: 90%;
      max-width: 400px;
    }

    h3 {
      text-align: center;
      margin-bottom: 1.5rem;
      color: #2563eb;
      font-size: 1.5rem;
    }

    input, textarea {
      width: 100%;
      border: 2px solid #e5e7eb;
      border-radius: 0.5rem;
      padding: 0.8rem;
      font-size: 1rem;
      margin-bottom: 1rem;
      transition: all 0.3s ease;
    }

    input:focus, textarea:focus {
      border-color: #2563eb;
      outline: none;
      box-shadow: 0 0 5px rgba(37, 99, 235, 0.3);
    }

    textarea {
      min-height: 120px;
      resize: vertical;
    }

    button {
      width: 100%;
      background-color: #2563eb;
      color: white;
      padding: 0.9rem;
      border: none;
      border-radius: 0.5rem;
      cursor: pointer;
      font-size: 1rem;
      font-weight: 500;
      transition: all 0.3s ease;
    }

    button:hover {
      background-color: #1d4ed8;
    }
  </style>
</head>
<body>
  <div class="container">
    <h3>Write A New Chat</h3>
    <form method="post" action="/chats">
      <input placeholder="Who Are You" name="from" required />
      <textarea name="msg" placeholder="Write Your Message Here..." required></textarea>
      <input placeholder="Add Receiver" name="to" required />
      <button type="submit">Create Chat</button>
    </form>
  </div>
</body>
</html>
